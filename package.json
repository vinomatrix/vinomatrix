{
  "name": "vinomatrix",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "test": "vitest run",
    "typecheck": "tsc -p . && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @vinomatrix/api migrate",
    "skills:mount": "node scripts/skills-external.mjs mount",
    "skills:update": "node scripts/skills-external.mjs update",
    "skills:unmount": "node scripts/skills-external.mjs unmount"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
