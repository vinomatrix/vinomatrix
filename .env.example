# Copy to .env for local overrides. Values below match docker-compose.yml.
DATABASE_URL=postgres://vinomatrix:vinomatrix@localhost:5432/vinomatrix
# Host port for the local PostGIS container, if 5432 is taken.
DB_PORT=5432

# geodienste.ch WFS access for the NE vineyard cadastre (see docs/DATA.md). Never commit real values.
GEODIENSTE_USER=
GEODIENSTE_PASSWORD=
